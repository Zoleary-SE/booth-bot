# ---------- admin page login ----------
ADMIN_USER=admin
# Must be changed: the admin page refuses to sign anyone in while this is still "changeme" or empty.
ADMIN_PASSWORD=changeme
# The admin page also asks for a 6-digit authenticator code; it walks you through setup on the first sign-in.
# Set to false only when serving plain HTTP on a LAN (the session cookie is otherwise HTTPS-only).
ADMIN_COOKIE_SECURE=true

# ---------- LLM backend ----------
# Model is a LiteLLM string. Pick ONE provider path below and set its creds.
LLM_MODEL=bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_FALLBACK_MODELS=gpt-4o-mini
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=600
LLM_TIMEOUT=30
# LLM_API_BASE=            # only for a proxy or ollama, e.g. http://app:11434

# Bedrock (leave AWS keys blank on ECS/App Runner to use the task IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# OpenAI (used as fallback above, or set LLM_MODEL=gpt-4o-mini to make it primary)
OPENAI_API_KEY=

# Anthropic direct (set LLM_MODEL=claude-haiku-4-5)
ANTHROPIC_API_KEY=

# Azure OpenAI (set LLM_MODEL=azure/<deployment-name>)
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# ---------- Zscaler AI Guard (DAS/API mode) ----------
AIGUARD_ENABLED=true
AIGUARD_API_BASE=https://api.us1.zseclipse.net
AIGUARD_API_KEY=
# Leave blank to resolve the policy bound to the key. Set an ID to pin one.
AIGUARD_POLICY_ID=
AIGUARD_DIRECTION_STYLE=IN_OUT      # or REQ_RESP if your tenant expects request/response
AIGUARD_TIMEOUT=15
AIGUARD_SCAN_PROMPT=true
AIGUARD_SCAN_RESPONSE=true
AIGUARD_BLOCK_ON_DETECT=false       # DETECT is monitor-only in AI Guard; true makes the demo block on it
AIGUARD_FAIL_CLOSED=false           # false = show the error but let the message through

# ---------- bot copy ----------
# general | halloween | thanksgiving | winter | spring | summer | july4 (sets the look, personality and default name/tagline)
BOT_THEME=general
# Leave these out to use the theme's own name and tagline.
# BOT_NAME=
# BOT_TAGLINE=
BOT_COMPANY=
BOT_MAX_PROMPT_CHARS=1000
BOT_RATE_LIMIT_PER_MIN=10
BOT_SESSION_TTL_MIN=30
BOT_HISTORY_TURNS=6
